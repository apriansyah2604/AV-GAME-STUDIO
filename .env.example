# NextAuth Configuration
AUTH_SECRET="your-secret-key-here"  # Generate with: openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth Credentials
# Get these from https://discord.com/developers/applications
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"

# Required Discord Server ID
# Get this by enabling Developer Mode in Discord (Settings > Advanced > Developer Mode)
# Then right-click your server and click "Copy ID"
REQUIRED_DISCORD_SERVER_ID="your-discord-server-id"
# Discord Server Invite Link
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/YOUR_INVITE_LINK"

# Optional local admin seed credentials
# In production, local username/password login only appears when these are set
DEFAULT_ADMIN_USERNAME=""
DEFAULT_ADMIN_PASSWORD=""

# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
