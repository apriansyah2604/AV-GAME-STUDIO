# NextAuth Configuration
AUTH_SECRET="your-secret-key-here"  # Generate with: openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Roblox OAuth 2.0 / OpenID Connect
# Register an app at https://create.roblox.com/dashboard/credentials.
# Add http://localhost:3000/api/auth/callback/roblox as a redirect URL for local development.
AUTH_ROBLOX_CLIENT_ID="your-roblox-client-id"
AUTH_ROBLOX_CLIENT_SECRET="your-roblox-client-secret"
# Comma-separated Roblox user IDs allowed to sign in.
AUTH_ROBLOX_ALLOWED_USER_IDS="your-roblox-user-id"
# Existing Supabase users.id for the admin account, to keep dashboard data ownership unchanged.
AUTH_ROBLOX_ADMIN_USER_ID="existing-supabase-admin-user-id"

# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# Server-only key for partner accounts, orders, and admin approval APIs.
# Never use the service-role key in a NEXT_PUBLIC_ variable or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Midtrans partner checkout
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="false"

# --- Roblox Payout Bot (server/index.js) ---
# Untuk Hugging Face Spaces, set ini di: Space Settings -> Variables and secrets
ROBLOX_COOKIE=".ROBLOSECURITY=your-roblox-security-cookie"
ROBLOX_GROUP_ID="390244299"
PAYOUT_SECRET_KEY="choose-a-strong-secret-key"
# URL public bot di Hugging Face Spaces (dipakai app/api/check-funds)
ROBLOX_SERVER_URL="https://username-space-name.hf.space"
# [OPSIONAL] Proxy residensial jika kena Error 403/Challenge dari Roblox
# PROXY_URL="http://username:password@ip:port"
