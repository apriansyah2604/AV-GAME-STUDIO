# NextAuth Configuration
AUTH_SECRET="your-secret-key-here"  # Generate with: openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
# Get these from https://console.cloud.google.com/
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional local admin seed credentials
# In production, local username/password login only appears when these are set
DEFAULT_ADMIN_USERNAME=""
DEFAULT_ADMIN_PASSWORD=""

# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
