# Konfigurasi Payout Otomatis Roblox
# Ambil cookie .ROBLOSECURITY dari browser (SANGAT RAHASIA)
ROBLOX_COOKIE="_|WARNING:-DO-NOT-SHARE-..."

# ID Grup Roblox Anda
ROBLOX_GROUP_ID="1234567"

# Midtrans Configuration
MIDTRANS_SERVER_KEY="your-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-client-key"
MIDTRANS_IS_PRODUCTION="false"

# Secret Key untuk mengamankan API payout Anda (bebas diisi apa saja)
PAYOUT_SECRET_KEY="av-studio-super-secret-key"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Port untuk server Express (VPS)
ROBLOX_SERVER_PORT=5000
ROBLOX_SERVER_URL="http://ip-vps-kamu:5000"

# Fonnte WhatsApp API
FONNTE_TOKEN="your-fonnte-token-here"
ADMIN_WHATSAPP="62895327025015"
